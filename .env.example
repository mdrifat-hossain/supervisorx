# PostgreSQL used by Docker Compose
POSTGRES_DB=supervisorx
POSTGRES_USER=supervisorx
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional Supabase PostgreSQL. When set, the app uses it instead of local Docker PostgreSQL.
# Direct endpoint URLs are routed through the Sydney session pooler for IPv4 compatibility.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_DB_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=research-papers
INTERNAL_API_KEY=replace-with-a-random-server-only-key

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth providers. Leave blank to hide/disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
